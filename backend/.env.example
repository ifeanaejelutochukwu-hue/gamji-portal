# ─── Server ───────────────────────────────────────────────
PORT=8080

# ─── Database ─────────────────────────────────────────────
# Get this from Neon, Railway, or your local PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/gamji_portal?sslmode=require

# ─── Authentication ────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRY_HOURS=24

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://gamji.edu.ng,http://localhost:3000

# ─── Email / SMTP ─────────────────────────────────────────
# For Gmail, use an App Password (not your main password)
# Enable 2FA on Gmail → Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@gamji.edu.ng
SMTP_PASS=your_app_password_here
SMTP_FROM=Gamji Portal <noreply@gamji.edu.ng>

# ─── Frontend URL (used in password reset emails) ─────────
FRONTEND_URL=https://gamji.edu.ng
